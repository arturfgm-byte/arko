# Настройки для хостинга reg.ru.
#
# Перевода на https здесь НЕТ намеренно. На этом хостинге запрос принимает nginx,
# а .htaccess читает Apache за ним, и признак защищённого соединения до Apache
# не доходит — правило срабатывало бесконечно (ERR_TOO_MANY_REDIRECTS).
# Перенаправление на https включается галочкой в панели, в настройках сайта.

RewriteEngine On

# Адрес с www склеиваем с адресом без www — у сайта должен быть один адрес.
# Здесь цикла быть не может: после перехода имя уже без www, условие не сработает.
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# Прежний адрес второй страницы, чтобы не отдавал ошибку
RewriteRule ^projects/?$ /#projects [R=301,L]

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>

ErrorDocument 404 /index.html
